*.aab

# Firebase config is per-developer/per-fork; never commit real credentials.
kid/google-services.json
parent/google-services.json
ios/**/GoogleService-Info.plist

# Swift Package Manager / Xcode build artifacts.
ios/.build/
ios/.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Release signing - never commit a keystore or its passwords (see docs/PUBLISHING.md).
keystore.properties
*.jks
*.keystore

# Firebase Local Emulator Suite logs, written into the working directory by `firebase emulators:start`.
firebase-debug.log
firestore-debug.log
ui-debug.log
