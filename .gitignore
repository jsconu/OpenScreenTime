*.iml
.gradle/
.idea/
local.properties
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab

# Firebase config is per-developer/per-fork; never commit real credentials. It lives in the
# :cloud module now, which is the only thing that reads it - a local build has no use for one.
cloud/src/main/assets/google-services.json
kid/google-services.json
parent/google-services.json
ios/**/GoogleService-Info.plist

# Swift Package Manager / Xcode build artifacts.
ios/.build/
ios/.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Release signing - never commit a keystore or its passwords (see docs/PUBLISHING.md).
keystore.properties
*.jks
*.keystore
.kotlin/
